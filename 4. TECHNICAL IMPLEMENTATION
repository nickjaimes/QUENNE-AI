                )
                
                threats.append({
                    'target': target,
                    'threat_level': threat_level,
                    'intent': intent,
                    'capability': capability,
                    'risk': risk,
                    'response_recommendations': response,
                    'timestamp': time.time()
                })
        
        # Sort by risk (highest first)
        threats.sort(key=lambda x: x['risk'], reverse=True)
        
        return {
            'threats': threats,

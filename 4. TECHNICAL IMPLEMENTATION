    def _setup_callbacks(self):
        """Set up dashboard callbacks"""
        
        @self.app.callback(
            Output('realtime-metrics', 'figure'),
            [Input('metrics-interval', 'n_intervals')]
        )
        def update_realtime_metrics(n):
            """Update real-time metrics graph"""
            
            # Get recent metrics
            recent = self.monitor.metrics_history[-50:] if self.monitor.metrics_history else []
            
            if not recent:
                return go.Figure()
            
            # Create figure with subplots
            fig = make_subplots(
                rows=2, cols=2,
                subplot_titles=('Homeostasis Score', 'Quantum Fidelity',
                              'Edge Latency', 'Neuromorphic Activity')
            )
            
            # Extract data
            timestamps = [datetime.fromtimestamp(m.timestamp) for m in recent]
            homeostasis = [m.homeostasis_score for m in recent]
            quantum = [m.quantum_fidelity for m in recent]
            latency = [m.edge_latency * 1000 for m in recent]  # Convert to ms
            neuro = [m.neuromorphic_activity for m in recent]
            
            # Add traces

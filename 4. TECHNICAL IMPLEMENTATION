        # Create variables
        x = {}
        for i in range(n_tasks):
            for j, resource in enumerate(problem['resource_info'].keys()):
                # Continuous variables for resource allocation
                x[i, j] = solver.NumVar(
                    0,  # Lower bound
                    problem['bounds'][i][j][1],  # Upper bound
                    f'x_{i}_{j}'
                )
        
        # Set objective
        objective = solver.Objective()
        for i in range(n_tasks):
            for j in range(n_resources):
                # Coefficient from objective function
                coeff = problem['objective']['coefficients'][i][j]
                objective.SetCoefficient(x[i, j], coeff)
        
        objective.SetMaximization()
        
        # Add constraints
        for constr in problem['constraints']:
            if constr['type'] == 'linear':
                constraint = solver.Constraint(
                    constr['lower'],
                    constr['upper']
                )
                for i, j, coeff in constr['coefficients']:
                    constraint.SetCoefficient(x[i, j], coeff)
        
        # Solve
        status = solver.Solve()
        
        if status == pywraplp.Solver.OPTIMAL:
            # Extract solution
            solution = np.zeros((n_tasks, n_resources))
            for i in range(n_tasks):
                for j in range(n_resources):
                    solution[i, j] = x[i, j].solution_value()
            
            return {
                'solution': solution,
                'objective_value': objective.Value(),
                'solve_time': solver.wall_time() / 1000,
                'status': 'optimal'
            }
        
        return {
            'solution': None,
            'objective_value': 0,
            'solve_time': solver.wall_time() / 1000,
            'status': 'infeasible' if status == pywraplp.Solver.INFEASIBLE else 'unknown'
        }
    
    def predictive_scaling(self, historical_data: List[Dict], 
                          forecast_horizon: int = 100):
        """Predict future resource needs and pre-scale"""
        
        # Time series forecasting of resource demands
        forecasts = {}
        
        for resource in self.resource_pools.keys():
            # Extract historical usage for this resource
            usage_history = [
                data['allocated'][resource] 
                for data in historical_data 
                if 'allocated' in data and resource in data['allocated']
            ]
            
            if len(usage_history) > 10:
                # Use ARIMA or similar for forecasting
                forecast = self._time_series_forecast(
                    usage_history, 
                    forecast_horizon
                )
                forecasts[resource] = forecast
        
        # Determine scaling actions
        scaling_actions = []
        
        for resource, forecast in forecasts.items():
            current = self.resource_pools[resource]['allocated']
            predicted_peak = max(forecast)
            
            if predicted_peak > current * 1.2:  # 20% increase predicted
                # Scale up
                scale_amount = predicted_peak - current
                scaling_actions.append({
                    'resource': resource,
                    'action': 'scale_up',
                    'amount': scale_amount,
                    'confidence': self._calculate_forecast_confidence(forecast)
                })
            elif predicted_peak < current * 0.8:  # 20% decrease predicted
                # Scale down
                scale_amount = current - predicted_peak
                scaling_actions.append({
                    'resource': resource,
                    'action': 'scale_down',
                    'amount': scale_amount,
                    'confidence': self._calculate_forecast_confidence(forecast)
                })
        
        return {
            'forecasts': forecasts,
            'scaling_actions': scaling_actions,
            'predicted_peak_demand': {
                r: max(f) for r, f in forecasts.items()
            }
        }

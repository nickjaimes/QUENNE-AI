# ethics/compliance_engine.py
import json
from typing import Dict, List, Optional, Set
from dataclasses import dataclass
from enum import Enum
import hashlib
from datetime import datetime

class EthicalPrinciple(Enum):
    AUTONOMY = "respect_for_autonomy"
    BENEFICENCE = "beneficence"
    NON_MALEFICENCE = "non_maleficence"
    JUSTICE = "justice"
    TRANSPARENCY = "transparency"
    ACCOUNTABILITY = "accountability"
    PRIVACY = "privacy"
    FAIRNESS = "fairness"

class EthicalViolationLevel(Enum):
    MINOR = "minor"
    MODERATE = "moderate"
    SEVERE = "severe"
    CRITICAL = "critical"

@dataclass
class EthicalConstraint:
    """Ethical constraint for decision-making"""
    principle: EthicalPrinciple
    condition: str
    action: str  # "allow", "deny", "require_human_review"
    severity: int  # 1-10
    description: str
    remediation: str

class EthicalComplianceEngine:
    """Ethical governance engine for QIL compliance"""
    
    def __init__(self, config_path: str = None):
        # Load ethical constraints from QIL
        self.constraints = self._load_constraints(config_path)
        
        # Decision audit log
        self.audit_log = []
        
        # Human oversight interface
        self.human_oversight = HumanOversightInterface()
        
        # Bias detection and mitigation
        self.bias_detector = BiasDetectionEngine()
        
        # Compliance monitoring
        self.compliance_monitor = ComplianceMonitor()
        
        # Violation history
        self.violation_history = []
        
    def evaluate_decision(self, decision: Dict, 
                         context: Dict,
                         require_review: bool = False) -> Dict:
        """
        Evaluate decision for ethical compliance
        
        Args:
            decision: Decision to evaluate
            context: Decision context
            require_review: Whether to require human review regardless
            
        Returns:
            Evaluation result
        """
        
        decision_id = self._generate_decision_id(decision)
        
        # Initialize evaluation
        evaluation = {
            'decision_id': decision_id,
            'timestamp': datetime.utcnow().isoformat(),
            'violations': [],
            'warnings': [],
            'recommendations': [],
            'requires_human_review': require_review,
            'approved': True,
            'confidence': 1.0,
            'explanation': {}
        }
        
        # Check each ethical constraint
        for constraint in self.constraints:
            violation = self._check_constraint(constraint, decision, context)
            
            if violation:
                evaluation['violations'].append(violation)
                
                # Apply constraint action
                if constraint.action == 'deny':
                    evaluation['approved'] = False
                    evaluation['denial_reason'] = violation['description']
                elif constraint.action == 'require_human_review':
                    evaluation['requires_human_review'] = True
        
        # Check for biases
        bias_check = self.bias_detector.check_decision(decision, context)
        if bias_check['detected']:
            evaluation['warnings'].append({
                'type': 'potential_bias',
                'description': bias_check['description'],
                'confidence': bias_check['confidence'],
                'mitigation_suggestion': bias_check['mitigation'],
                'severity': bias_check.get('severity', 'moderate')
            })
        
        # Check for privacy violations
        privacy_check = self._check_privacy(decision, context)
        if privacy_check['violations']:
            evaluation['violations'].extend(privacy_check['violations'])
        
        # Calculate ethical score
        evaluation['ethical_score'] = self._calculate_ethical_score(evaluation)
        
        # Adjust confidence based on violations
        if evaluation['violations']:
            max_severity = max([v.get('severity', 1) for v in evaluation['violations']])
            evaluation['confidence'] = 1.0 - (max_severity / 10.0)
        
        # Generate explanation
        evaluation['explanation'] = self._generate_explanation(decision, evaluation)
        
        # If requires human review, get human input
        if evaluation['requires_human_review']:
            human_decision = self.human_oversight.get_review(decision, evaluation)
            evaluation['human_review'] = human_decision
            
            # Update approval based on human review
            if human_decision.get('override', False):
                evaluation['approved'] = human_decision.get('approved', False)
                evaluation['human_override'] = True
                evaluation['override_reason'] = human_decision.get('reason', '')
        
        # Log the evaluation
        self.audit_log.append(evaluation)
        
        # Update compliance monitoring
        self.compliance_monitor.record_evaluation(evaluation)
        
        return evaluation
    
    def _check_constraint(self, constraint: EthicalConstraint,
                         decision: Dict, context: Dict) -> Optional[Dict]:
        """Check if decision violates a constraint"""
        
        try:
            # Create safe evaluation context
            eval_context = {
                'decision': self._sanitize_for_eval(decision),
                'context': self._sanitize_for_eval(context),
                'system': self._get_system_state()
            }
            
            # Evaluate condition using safe evaluator
            condition_met = self._safe_evaluate(
                constraint.condition, 
                eval_context
            )
            
            if condition_met:
                return {
                    'principle': constraint.principle.value,
                    'severity': constraint.severity,
                    'description': constraint.description,
                    'constraint': constraint.condition,
                    'remediation': constraint.remediation,
                    'timestamp': datetime.utcnow().isoformat()
                }
        
        except Exception as e:
            # Log evaluation error but don't fail the check
            print(f"Error evaluating constraint: {e}")
        
        return None
    
    def bias_detection_and_mitigation(self, data: Dict, 
                                     model_output: Dict) -> Dict:
        """
        Detect and mitigate biases in data and model outputs
        
        Args:
            data: Input data
            model_output: Model predictions/outputs
        
        Returns:
            Bias detection and mitigation results
        """
        
        detection_results = {
            'statistical_biases': self.bias_detector.check_statistical_biases(data),
            'representation_biases': self.bias_detector.check_representation_biases(data),
            'historical_biases': self.bias_detector.check_historical_biases(data),
            'aggregation_biases': self.bias_detector.check_aggregation_biases(data),
            'evaluation_biases': self.bias_detector.check_evaluation_biases(model_output),
            'algorithmic_biases': self.bias_detector.check_algorithmic_biases(data, model_output)
        }
        
        # Calculate overall bias score
        bias_score = self._calculate_bias_score(detection_results)
        
        # Generate mitigation strategies
        mitigations = []
        if bias_score > 0.3:
            mitigations = self.bias_detector.generate_mitigations(detection_results)
        
        # Apply automatic mitigations if bias is severe
        mitigated_output = model_output
        if bias_score > 0.7:
            mitigated_output = self.bias_detector.apply_mitigations(
                model_output, mitigations
            )
        
        return {
            'bias_detection': detection_results,
            'overall_bias_score': bias_score,
            'mitigation_strategies': mitigations,
            'mitigated_output': mitigated_output,
            'recommended_actions': self._generate_bias_correction_actions(
                detection_results, bias_score
            ),
            'requires_human_review': bias_score > 0.5
        }
    
    def transparent_decision_explanation(self, decision: Dict,
                                       evaluation: Dict) -> Dict:
        """
        Generate transparent explanation of decision
        
        Args:
            decision: Original decision
            evaluation: Ethical evaluation result
        
        Returns:
            Comprehensive explanation
        """
        
        explanation = {
            'summary': self._generate_summary(decision, evaluation),
            'factors_considered': self._list_factors(decision, evaluation),
            'alternatives_considered': self._list_alternatives(decision),
            'confidence_levels': self._extract_confidence_levels(decision),
            'uncertainty_acknowledgement': self._acknowledge_uncertainties(decision),
            'ethical_considerations': {
                'violations': evaluation.get('violations', []),
                'warnings': evaluation.get('warnings', []),
                'score': evaluation.get('ethical_score', 0.0)
            },
            'human_involvement': evaluation.get('human_review', {}),
            'audit_trail': self._generate_audit_trail(decision),
            'version_information': {
                'model_version': 'QUENNE-2.1',
                'ethical_framework': 'QIL-1.2',
                'compliance_engine_version': '1.0',
                'decision_timestamp': datetime.utcnow().isoformat()
            }
        }
        
        # Convert to human-readable format
        human_readable = self._convert_to_human_readable(explanation)
        
        # Create visualization data
        visualization = self._create_visualization(explanation)
        
        return {
            'technical': explanation,
            'human_readable': human_readable,
            'visualization': visualization,
            'export_formats': ['json', 'html', 'pdf', 'markdown']
        }
    
    def continuous_ethical_learning(self, feedback: List[Dict]) -> Dict:
        """
        Continuously learn from ethical feedback
        
        Args:
            feedback: List of feedback items
        
        Returns:
            Learning results
        """
        
        # Analyze feedback
        feedback_analysis = self._analyze_feedback(feedback)
        
        # Update ethical constraints
        updated_constraints = self._update_constraints(feedback_analysis)
        
        # Update bias detection models
        updated_bias_models = self.bias_detector.update_models(feedback_analysis)
        
        # Update compliance thresholds
        updated_thresholds = self.compliance_monitor.update_thresholds(feedback_analysis)
        
        # Log learning
        learning_record = {
            'timestamp': datetime.utcnow().isoformat(),
            'feedback_samples': len(feedback),
            'analysis': feedback_analysis,
            'constraint_updates': updated_constraints,
            'bias_model_updates': updated_bias_models,
            'threshold_updates': updated_thresholds
        }
        
        self._log_ethical_learning(learning_record)
        
        return {
            'learning_cycle_complete': True,
            'constraints_updated': len(updated_constraints),
            'bias_models_updated': updated_bias_models,
            'thresholds_updated': updated_thresholds,
            'ethical_improvement_score': self._calculate_improvement_score(feedback_analysis),
            'recommendations': self._generate_learning_recommendations(feedback_analysis)
        }

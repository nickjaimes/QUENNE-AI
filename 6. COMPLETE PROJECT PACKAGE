        }
    
    def _detect_objects(self, fused_data: Dict) -> List[Detection]:
        """Detect objects in fused sensor data"""
        
        detections = []
        
        # Process visual data
        if 'rgb' in fused_data:
            rgb_image = fused_data['rgb']
            
            if hasattr(self.object_detector, 'predict'):
                # YOLO model
                results = self.object_detector.predict(
                    rgb_image,
                    conf=0.7,
                    iou=0.5,
                    verbose=False
                )
                
                for result in results:
                    boxes = result.boxes.xyxy.cpu().numpy()
                    confidences = result.boxes.conf.cpu().numpy()
                    class_ids = result.boxes.cls.cpu().numpy()
                    
                    for box, conf, cls in zip(boxes, confidences, class_ids):
                        detection = Detection(
                            bbox=tuple(box.tolist()),
                            confidence=float(conf),
                            class_id=int(cls),
                            class_name=self.object_detector.names[int(cls)],
                            source='rgb',
                            metadata={
                                'image_shape': rgb_image.shape,
                                'detector': 'yolov8'
                            }
                        )
                        detections.append(detection)
            else:
                # Torchvision model
                import torchvision.transforms as T
                transform = T.Compose([T.ToTensor()])
                img_tensor = transform(rgb_image).unsqueeze(0)
                
                with torch.no_grad():
                    predictions = self.object_detector(img_tensor)
                
                for pred in predictions:
                    boxes = pred['boxes'].cpu().numpy()
                    scores = pred['scores'].cpu().numpy()
                    labels = pred['labels'].cpu().numpy()
                    
                    for box, score, label in zip(boxes, scores, labels):
                        if score > 0.7:
                            detection = Detection(
                                bbox=tuple(box.tolist()),
                                confidence=float(score),
                                class_id=int(label),
                                class_name=self._get_class_name(label),
                                source='rgb',
                                metadata={
                                    'image_shape': rgb_image.shape,
                                    'detector': 'faster_rcnn'
                                }
                            )
                            detections.append(detection)
        
        # Process LiDAR point cloud
        if 'point_cloud' in fused_data:
            pc = fused_data['point_cloud']
            
            # Convert to Open3D point cloud
            pcd = o3d.geometry.PointCloud()
            pcd.points = o3d.utility.Vector3dVector(pc)
            
            # Cluster using DBSCAN
            labels = np.array(pcd.cluster_dbscan(eps=0.5, min_points=10))
            
            # Extract clusters as objects
            unique_labels = np.unique(labels)
            for label in unique_labels:
                if label >= 0:  # Ignore noise
                    cluster_points = pc[labels == label]
                    if len(cluster_points) > 0:
                        # Calculate 3D bounding box
                        min_bound = np.min(cluster_points, axis=0)
                        max_bound = np.max(cluster_points, axis=0)
                        center = np.mean(cluster_points, axis=0)
                        
                        detection = Detection(
                            bbox=tuple(np.concatenate([min_bound, max_bound])),
                            confidence=min(1.0, len(cluster_points) / 1000),
                            class_id=-1,
                            class_name='object_3d',
                            source='lidar',
                            metadata={
                                'point_count': len(cluster_points),
                                'center': center.tolist(),
                                'cluster_id': label
                            }
                        )
                        detections.append(detection)
        
        return detections
    

class HybridEncryption:
    """Hybrid encryption combining PQC and symmetric crypto"""
    
    def __init__(self):
        self.aes_key_size = 32  # 256-bit AES key
    
    def encrypt(self, plaintext: bytes, pqc_algorithm: str) -> Tuple[bytes, bytes]:
        """
        Hybrid encryption: PQC for key exchange, AES for data
        
        Args:
            plaintext: Data to encrypt
            pqc_algorithm: PQC algorithm for key encapsulation
        
        Returns:
            Tuple of (ciphertext, encapsulated_key)
        """
        
        # Generate random AES key
        aes_key = os.urandom(self.aes_key_size)
        
        # Encrypt data with AES-GCM
        iv = os.urandom(12)  # 96-bit IV for GCM
        cipher = Cipher(
            algorithms.AES(aes_key),
            modes.GCM(iv),
            backend=default_backend()
        )
        encryptor = cipher.encryptor()
        ciphertext = encryptor.update(plaintext) + encryptor.finalize()
        
        # Get authentication tag
        auth_tag = encryptor.tag
        
        # Encapsulate AES key using PQC
        # In production, would use actual PQC KEM
        # For now, simulate with RSA (not quantum-safe)
        from cryptography.hazmat.primitives.asymmetric import padding as rsa_padding
        private_key = rsa.generate_private_key(
            public_exponent=65537,
            key_size=4096,
            backend=default_backend()
        )
        public_key = private_key.public_key()
        
        encapsulated_key = public_key.encrypt(
            aes_key,
            rsa_padding.OAEP(
                mgf=rsa_padding.MGF1(algorithm=hashes.SHA256()),
                algorithm=hashes.SHA256(),
                label=None
            )
        )
        
        # Combine IV, ciphertext, and auth tag
        combined = iv + auth_tag + ciphertext
        
        return combined, encapsulated_key
    
    def decrypt(self, ciphertext_combined: bytes,
                encapsulated_key: bytes) -> bytes:
        """
        Decrypt hybrid-encrypted data
        
        Args:
            ciphertext_combined: Combined IV + auth_tag + ciphertext
            encapsulated_key: Encapsulated AES key
        
        Returns:
            Decrypted plaintext
        """
        
        # Extract components
        iv = ciphertext_combined[:12]
        auth_tag = ciphertext_combined[12:28]
        ciphertext = ciphertext_combined[28:]
        
        # Decapsulate AES key
        # In production, would use actual PQC KEM
        # For now, simulate with RSA (not quantum-safe)
        from cryptography.hazmat.primitives.asymmetric import padding as rsa_padding
        private_key = rsa.generate_private_key(
            public_exponent=65537,
            key_size=4096,
            backend=default_backend()
        )
        
        aes_key = private_key.decrypt(
            encapsulated_key,
            rsa_padding.OAEP(
                mgf=rsa_padding.MGF1(algorithm=hashes.SHA256()),
                algorithm=hashes.SHA256(),
                label=None
            )
        )
        
        # Decrypt data with AES-GCM
        cipher = Cipher(
            algorithms.AES(aes_key),
            modes.GCM(iv, auth_tag),
            backend=default_backend()
        )
        decryptor = cipher.decryptor()
        plaintext = decryptor.update(ciphertext) + decryptor.finalize()
        
        return plaintext

class QuantumKeyDistribution:
    """Quantum Key Distribution simulation"""
    
    def bb84_protocol(self, alice: str, bob: str) -> Dict:
        """
        Implement BB84 quantum key distribution protocol
        
        Args:
            alice: Sender identifier
            bob: Receiver identifier
        
        Returns:
            QKD results including shared key
        """
        
        # Alice's preparations
        n_bits = 256  # Key length
        alice_bits = np.random.randint(0, 2, n_bits)
        alice_bases = np.random.choice(['+', '×'], n_bits)
        
        # Encode qubits
        qubits = self._encode_qubits(alice_bits, alice_bases)
        
        # Bob's measurements
        bob_bases = np.random.choice(['+', '×'], n_bits)
        bob_bits = self._measure_qubits(qubits, bob_bases)
        
        # Sift key (keep bits where bases match)
        matching_bases = alice_bases == bob_bases
        sifted_key_alice = alice_bits[matching_bases]
        sifted_key_bob = bob_bits[matching_bases]
        
        # Error estimation
        sample_size = min(20, len(sifted_key_alice))
        sample_indices = np.random.choice(
            len(sifted_key_alice), sample_size, replace=False
        )
        sample_alice = sifted_key_alice[sample_indices]
        sample_bob = sifted_key_bob[sample_indices]
        
        error_rate = np.mean(sample_alice != sample_bob)
        
        if error_rate < 0.11:  # Acceptable error rate for BB84
            # Error correction
            corrected_key = self._error_correction(
                sifted_key_alice, sifted_key_bob, error_rate
            )
            
            # Privacy amplification
            final_key = self._privacy_amplification(corrected_key)
            
            return {
                'success': True,
                'key': final_key,
                'key_length': len(final_key),
                'error_rate': error_rate,
                'eavesdropping_detected': error_rate > 0.11,
                'protocol': 'BB84',
                'participants': [alice, bob]
            }
        
        return {
            'success': False,
            'error_rate': error_rate,
            'eavesdropping_detected': error_rate > 0.11,
            'protocol': 'BB84',
            'participants': [alice, bob]
        }
    
    def _encode_qubits(self, bits: np.ndarray, bases: np.ndarray) -> List:
        """Encode classical bits into quantum states"""
        
        qubits = []
        for bit, basis in zip(bits, bases):
            if basis == '+':
                # Rectilinear basis
                if bit == 0:
                    qubits.append('|0⟩')  # Horizontal polarization
                else:
                    qubits.append('|1⟩')  # Vertical polarization
            else:
                # Diagonal basis
                if bit == 0:
                    qubits.append('|+⟩')  # +45° polarization
                else:
                    qubits.append('|-⟩')  # -45° polarization
        
        return qubits
    
    def _measure_qubits(self, qubits: List, bases: np.ndarray) -> np.ndarray:
        """Measure qubits in specified bases"""
        
        measured_bits = []
        for qubit, basis in zip(qubits, bases):
            if basis == '+':
                # Measure in rectilinear basis
                if qubit in ['|0⟩', '|+⟩']:
                    measured_bits.append(0)
                else:
                    measured_bits.append(1)
            else:
                # Measure in diagonal basis
                if qubit in ['|+⟩', '|0⟩']:
                    measured_bits.append(0)
                else:
                    measured_bits.append(1)
        
        return np.array(measured_bits)

            time_steps: Number of time steps to simulate
            
        Returns:
            Dictionary containing spike recordings and membrane potentials
        """
        
        # Reset hidden states
        for module in self.snn:
            if hasattr(module, 'reset_hidden'):
                module.reset_hidden()
        
        # Initialize recordings
        spike_recordings = []
        mem_recordings = []
        
        # Time-stepped simulation
        for step in range(time_steps):
            cur_input = input_spikes[step]
            
            # Forward pass
            spike_out, mem_out = self.snn(cur_input)
            
            # Record
            spike_recordings.append(spike_out)
            mem_recordings.append(mem_out)
            
            # Apply learning rules
            if step > 0:
                self._apply_learning_rules(
                    spike_recordings[-2],
                    spike_recordings[-1],
                    step
                )
            
            # Store spike events
            spike_events = self._extract_spike_events(spike_out, step)
            self.spike_buffer.extend(spike_events)
        
        return {
            'spikes': torch.stack(spike_recordings),
            'membrane_potentials': torch.stack(mem_recordings),
            'total_spikes': sum([s.sum() for s in spike_recordings]),
            'firing_rate': self._calculate_firing_rate(spike_recordings)
        }
    
    def _apply_learning_rules(self, pre_spikes: torch.Tensor,
                             post_spikes: torch.Tensor, time_step: int):
        """Apply learning rules based on spike timing"""
        
        # Apply STDP
        stdp_updates = self.learning_rules['stdp'].calculate_update(
            pre_spikes, post_spikes, time_step
        )
        
        # Apply homeostatic plasticity
        homeostatic_updates = self.learning_rules['homeostatic'].calculate_update(
            pre_spikes, post_spikes
        )
        
        # Combine updates
        total_update = stdp_updates + homeostatic_updates
        
        # Apply to network weights
        self._update_network_weights(total_update)
        
        # Record weight changes
        self.weight_history.append({
            'time_step': time_step,
            'updates': total_update.norm().item(),
            'rule_contributions': {
                'stdp': stdp_updates.norm().item(),
                'homeostatic': homeostatic_updates.norm().item()
            }
        })
    
    def associative_recall(self, partial_pattern: np.ndarray,
                          threshold: float = 0.7) -> Dict:
        """Perform associative memory recall"""
        
        # Encode pattern into spikes
        spike_pattern = self._encode_pattern(partial_pattern)
        
        # Recall from associative memory
        recalled = self.memory['associative'].recall(
            spike_pattern, threshold=threshold
        )
        
        # Decode recalled pattern
        decoded = self._decode_pattern(recalled)
        
        return {
            'recalled_pattern': decoded,
            'confidence': self._calculate_recall_confidence(recalled),
            'similarity_to_input': self._calculate_pattern_similarity(
                partial_pattern, decoded
            ),
            'recall_time': len(recalled) * 10  # 10ms per time step
        }
    
    def lifelong_learning(self, new_data: torch.Tensor,
                         retention_factor: float = 0.9) -> Dict:
        """Implement lifelong learning without catastrophic forgetting"""
        
        # Consolidate existing memories
        consolidation_result = self._consolidate_memories(retention_factor)
        
        # Learn new patterns with regularization
        learning_result = self._regularized_learning(new_data)
        
        # Update with minimal interference
        update_result = self._update_without_interference(
            consolidation_result, learning_result
        )
        
        # Verify learning stability
        stability = self._check_learning_stability()
        
        return {
            'consolidation': consolidation_result,
            'new_learning': learning_result,
            'update_result': update_result,
            'stability_score': stability,
            'catastrophic_forgetting_measured': self._measure_forgetting(),
            'retention_rate': retention_factor
        }

class STDPRule:
    """Spike-Timing-Dependent Plasticity implementation"""
    
    def __init__(self, tau_plus: float = 20.0, tau_minus: float = 20.0,
                 a_plus: float = 0.1, a_minus: float = 0.12):
        self.tau_plus = tau_plus  # LTP time constant (ms)
        self.tau_minus = tau_minus  # LTD time constant (ms)
        self.a_plus = a_plus  # LTP learning rate
        self.a_minus = a_minus  # LTD learning rate
        
        # Spike trace buffers
        self.pre_trace = 0.0
        self.post_trace = 0.0
        
    def calculate_update(self, pre_spikes: torch.Tensor,
                        post_spikes: torch.Tensor,
                        time_step: int) -> torch.Tensor:
        """Calculate weight updates based on spike timing"""
        
        batch_size = pre_spikes.shape[0]
        update = torch.zeros_like(pre_spikes)
        
        for i in range(batch_size):
            # Update spike traces
            pre_trace, post_trace = self._update_traces(
                pre_spikes[i], post_spikes[i], dt=1.0
            )
            
            # Calculate weight changes
            for j in range(pre_spikes.shape[1]):
                if pre_spikes[i, j] > 0 and post_spikes[i, j] > 0:
                    # Both neurons fired - apply STDP
                    delta_t = self._get_spike_time_difference(i, j, time_step)
                    
                    if delta_t > 0:
                        # Pre-before-post: LTP
                        weight_change = self.a_plus * np.exp(-delta_t / self.tau_plus)
                        update[i, j] = weight_change
                    else:
                        # Post-before-pre: LTD
                        weight_change = -self.a_minus * np.exp(delta_t / self.tau_minus)
                        update[i, j] = weight_change
        
        return update
    
    def _update_traces(self, pre_spike: float, post_spike: float,
                      dt: float = 1.0) -> Tuple[float, float]:
        """Update spike traces with exponential decay"""
        
        # Decay existing traces
        self.pre_trace *= np.exp(-dt / self.tau_plus)
        self.post_trace *= np.exp(-dt / self.tau_minus)
        
        # Add new spikes
        if pre_spike > 0:
            self.pre_trace += 1.0
        if post_spike > 0:
            self.post_trace += 1.0
        
        return self.pre_trace, self.post_trace

class AssociativeMemory:
    """Content-addressable associative memory"""
    
    def __init__(self, capacity: int = 1000):
        self.capacity = capacity
        self.memory_matrix = np.zeros((capacity, capacity))
        self.patterns = []
        self.pattern_labels = []
        
    def store(self, pattern: np.ndarray, label: Optional[str] = None) -> bool:
        """Store pattern using Hebbian learning"""
        
        # Binarize pattern
        binary_pattern = (pattern > 0.5).astype(float)
        
        if len(self.patterns) < self.capacity:
            self.patterns.append(binary_pattern)
            self.pattern_labels.append(label)
            
            # Hebbian update
            outer_product = np.outer(binary_pattern, binary_pattern)
            np.fill_diagonal(outer_product, 0)  # No self-connections
            
            self.memory_matrix += outer_product
            
            # Normalize
            self.memory_matrix = np.clip(self.memory_matrix, -1, 1)
            
            return True
        
        return False
    
    def recall(self, partial_pattern: np.ndarray,
              threshold: float = 0.7, max_iterations: int = 100) -> Dict:
        """Recall pattern from partial cue"""
        
        current_state = partial_pattern.copy()
        
        for iteration in range(max_iterations):
            # Spread of activation
            new_state = np.dot(self.memory_matrix, current_state)
            
            # Apply threshold
            new_state = (new_state > threshold).astype(float)
            
            # Check for convergence
            if np.array_equal(new_state, current_state):
                break
            
            current_state = new_state
        
        # Find closest stored pattern
        if len(self.patterns) > 0:
            similarities = [
                self._calculate_similarity(current_state, p)
                for p in self.patterns
            ]
            best_match_idx = np.argmax(similarities)
            
            return {
                'recalled_state': current_state,
                'best_match': self.patterns[best_match_idx],
                'similarity': similarities[best_match_idx],
                'label': self.pattern_labels[best_match_idx],
                'iterations': iteration + 1,
                'converged': iteration < max_iterations - 1
            }
        
        return {
            'recalled_state': current_state,
            'iterations': iteration + 1,
            'converged': iteration < max_iterations - 1
        }
    
    def _calculate_similarity(self, a: np.ndarray, b: np.ndarray) -> float:
        """Calculate similarity between two patterns"""
        
        return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b) + 1e-10)

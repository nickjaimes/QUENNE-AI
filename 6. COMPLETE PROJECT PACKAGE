        self.threat_models = self._load_threat_models()
        self.intent_models = self._load_intent_models()
        self.capability_models = self._load_capability_models()
        
    def assess_threat(self, target: Dict, context: Dict = None) -> float:
        """Assess threat level of a target"""
        
        threat_factors = []
        
        # Factor 1: Proximity
        proximity = self._calculate_proximity_threat(target, context)
        threat_factors.append(('proximity', proximity, 0.3))
        
        # Factor 2: Behavior
        behavior = self._calculate_behavior_threat(target, context)
        threat_factors.append(('behavior', behavior, 0.25))
        
        # Factor 3: Known threat patterns
        pattern_match = self._check_threat_patterns(target, context)
        threat_factors.append(('pattern_match', pattern_match, 0.2))
        
        # Factor 4: Capability assessment
        capability = self._assess_capability(target, context)
        threat_factors.append(('capability', capability, 0.15))
        
        # Factor 5: Contextual factors
        contextual = self._assess_contextual_threat(target, context)
        threat_factors.append(('contextual', contextual, 0.1))
        
        # Calculate weighted threat level
        threat_level = sum(factor[1] * factor[2] for factor in threat_factors)
        
        # Apply uncertainty adjustment
        uncertainty = target.get('target_confidence', 1.0)
        adjusted_threat = threat_level * uncertainty
        
        return min(1.0, adjusted_threat)  # Cap at 1.0
    
    def _calculate_proximity_threat(self, target: Dict, context: Dict) -> float:
        """Calculate threat based on proximity"""
        
        if 'pose' not in target:
            return 0.0
        
        target_pos = target['pose'].get('position', [0, 0, 0])
        
        # Get self position from context
        self_pos = context.get('self_position', [0, 0, 0]) if context else [0, 0, 0]
        
        # Calculate distance
        distance = np.linalg.norm(np.array(target_pos) - np.array(self_pos))
        
        # Convert distance to threat (closer = higher threat)
        # Assuming 100m is maximum relevant distance
        max_distance = 100.0
        proximity_threat = 1.0 - min(1.0, distance / max_distance)
        
        return proximity_threat
    
    def _calculate_behavior_threat(self, target: Dict, context: Dict) -> float:
        """Calculate threat based on behavior"""
        
        behavior = target.get('features', {}).get('behavior', {})
        
        # Check for aggressive movements
        velocity = behavior.get('velocity', 0.0)
        acceleration = behavior.get('acceleration', 0.0)
        
        # Normalize to threat values
        vel_threat = min(1.0, velocity / 20.0)  # 20 m/s max
        acc_threat = min(1.0, acceleration / 10.0)  # 10 m/s² max
        
        # Check for direct approach
        direction = behavior.get('direction', 0.0)
        approach_threat = 1.0 if abs(direction) < 0.2 else 0.0  # Direct approach
        
        # Combine behavior factors
        behavior_threat = (vel_threat * 0.3 + acc_threat * 0.3 + approach_threat * 0.4)
        
        return behavior_threat

import numpy as np
from typing import Dict, List
import json

class HealthcareDataset:
    """Healthcare dataset for QUENNE training"""
    
    def __init__(self):
        self.patients = self._load_patient_data()
        self.diagnoses = self._load_diagnosis_data()
        self.treatments = self._load_treatment_data()
        self.outcomes = self._load_outcome_data()
    
    def _load_patient_data(self) -> pd.DataFrame:
        """Load patient demographic and medical history data"""
        
        data = {
            'patient_id': range(1000),
            'age': np.random.randint(18, 90, 1000),
            'gender': np.random.choice(['M', 'F'], 1000),
            'weight_kg': np.random.normal(70, 15, 1000).clip(40, 150),
            'height_cm': np.random.normal(170, 10, 1000).clip(140, 210),
            'blood_pressure_systolic': np.random.normal(120, 15, 1000).clip(80, 200),
            'blood_pressure_diastolic': np.random.normal(80, 10, 1000).clip(50, 120),
            'cholesterol': np.random.normal(200, 40, 1000).clip(100, 300),
            'glucose': np.random.normal(100, 20, 1000).clip(70, 200),
            'smoker': np.random.choice([0, 1], 1000, p=[0.7, 0.3]),
            'diabetes': np.random.choice([0, 1], 1000, p=[0.85, 0.15]),
            'hypertension': np.random.choice([0, 1], 1000, p=[0.7, 0.3]),
            'family_history_heart_disease': np.random.choice([0, 1], 1000, p=[0.6, 0.4])
        }
        
        return pd.DataFrame(data)
    
    def get_training_data(self) -> Dict:
        """Get training data for healthcare applications"""
        
        # Generate synthetic symptoms and diagnoses
        training_data = []
        
        for _, patient in self.patients.iterrows():
            # Generate symptoms based on patient characteristics
            symptoms = self._generate_symptoms(patient)
            
            # Generate diagnosis based on symptoms and patient data
            diagnosis = self._generate_diagnosis(patient, symptoms)
            
            # Generate treatment
            treatment = self._generate_treatment(diagnosis, patient)
            
            # Generate outcome
            outcome = self._generate_outcome(patient, diagnosis, treatment)
            
            training_example = {
                'patient_data': patient.to_dict(),
                'symptoms': symptoms,
                'diagnosis': diagnosis,
                'treatment': treatment,
                'outcome': outcome
            }
            
            training_data.append(training_example)
        
        return {
            'training_examples': training_data,
            'metadata': {
                'total_patients': len(training_data),
                'feature_count': len(self.patients.columns),
                'diagnosis_categories': self._get_diagnosis_categories(),
                'treatment_types': self._get_treatment_types()
            }
        }

class AutonomousDrivingDataset:
    """Autonomous driving dataset for QUENNE training"""
    
    def __init__(self):
        self.scenarios = self._generate_scenarios()
        self.road_conditions = self._generate_road_conditions()
        self.traffic_patterns = self._generate_traffic_patterns()
    
    def _generate_scenarios(self) -> List[Dict]:
        """Generate driving scenarios"""
        
        scenarios = []
        
        # Urban driving scenarios
        urban_scenarios = [
            {
                'type': 'intersection',
                'description': 'Approaching four-way stop',
                'actors': ['ego_vehicle', 'pedestrian', 'oncoming_car'],
                'environment': {'time_of_day': 'day', 'weather': 'clear'},
                'challenges': ['right_of_way', 'pedestrian_safety', 'traffic_signs']
            },
            {
                'type': 'highway_merging',
                'description': 'Merging onto highway',
                'actors': ['ego_vehicle', 'merging_vehicle', 'highway_traffic'],
                'environment': {'time_of_day': 'night', 'weather': 'rain'},
                'challenges': ['speed_matching', 'gap_selection', 'blind_spots']
            },
            {
                'type': 'pedestrian_crossing',
                'description': 'Pedestrian unexpectedly crossing',
                'actors': ['ego_vehicle', 'pedestrian', 'parked_cars'],
                'environment': {'time_of_day': 'dusk', 'weather': 'fog'},
                'challenges': ['reaction_time', 'braking_distance', 'obstacle_detection']
            }
        ]
        
        return urban_scenarios
    
    def get_training_data(self) -> Dict:
        """Get training data for autonomous driving"""
        
        training_data = []
        
        for scenario in self.scenarios:
            # Generate sensor data for scenario
            sensor_data = self._generate_sensor_data(scenario)
            
            # Generate correct actions for scenario
            correct_actions = self._generate_correct_actions(scenario)
            
            # Generate ethical considerations
            ethical_considerations = self._generate_ethical_considerations(scenario)
            
            training_example = {
                'scenario': scenario,
                'sensor_data': sensor_data,
                'correct_actions': correct_actions,
                'ethical_considerations': ethical_considerations,
                'difficulty_level': self._calculate_difficulty(scenario)
            }
            
            training_data.append(training_example)
        
        return {
            'training_scenarios': training_data,
            'scenario_types': list(set([s['type'] for s in self.scenarios])),
            'total_scenarios': len(training_data),
            'metadata': {
                'generation_date': '2026-01-15',
                'version': '2.1.0',
                'purpose': 'autonomous_vehicle_training'
            }
        }
